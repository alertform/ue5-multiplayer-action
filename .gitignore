# UE5 gitignore
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Visual Studio
.vs/
*.user

# Compiled files
*.pdb
*.exp
*.lib

# Keep
!Source/
!Config/
!Content/*.uasset
!Content/*.umap
!*.uproject

# Local AI assistant notes — not for public repo
CLAUDE.md
.claude/
.omc/

# IDE / local tooling
.idea/
.vsconfig
Plugins/Developer/

# External packs default to LOCAL-ONLY (marketplace licenses + repo size).
# New imports go to Content/External/<PackName>/ and are ignored automatically;
# to ship specific packs/files, re-include them below (StarterContent block is the template).
Content/External/*
!Content/External/GhostSamurai_Bundle
!Content/External/StarterContent
!Content/External/MageBundleSamples

# Local-only asset packs — marketplace content must not be redistributed in a public repo
Content/External/MageBundleSamples/

# StarterContent: ignore-all + per-file exemptions (dependency closure of ThirdPersonMap
# dressing + committed FX blueprints; regenerate via MCP get_references BFS)
Content/External/StarterContent/**
!Content/External/StarterContent/**/
!Content/External/StarterContent/Architecture/Pillar_50x500.uasset
!Content/External/StarterContent/Materials/M_Basic_Wall.uasset
!Content/External/StarterContent/Materials/M_Rock_Slate.uasset
