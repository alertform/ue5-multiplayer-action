# UE5 gitignore
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Visual Studio
.vs/
*.user

# Compiled files
*.pdb
*.exp
*.lib

# Keep
!Source/
!Config/
!Content/*.uasset
!Content/*.umap
!*.uproject

# Local AI assistant notes — not for public repo
CLAUDE.md
.claude/
.omc/

# IDE / local tooling
.idea/
.vsconfig
Plugins/Developer/

# Local-only asset packs — marketplace content must not be redistributed in a public repo
Content/MageBundleSamples/
Content/StarterContent/
